# Copy to .env and fill. Never commit .env.

# Telegram BotFather token
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use /admin
ADMIN_IDS=

# Crypto Pay (CryptoBot) API token — leave empty to use manual admin credit only
CRYPTO_PAY_TOKEN=

# Optional webhook (leave empty for long polling)
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook

# SQLite path (relative to apps/bot or absolute)
DATABASE_URL=sqlite+aiosqlite:///./data/shop.db

# Public bot username without @ (for landing deep links)
BOT_USERNAME=

# Pricing in RUB (monthly base)
PRICE_1M=299
PRICE_3M=799
PRICE_12M=2490

# Support contact (t.me username or URL shown to buyers)
SUPPORT_URL=https://t.me/
